# depool-control — the stack control sidecar (docker CLI + compose plugin +
# node on alpine) with the app's own compose baked at /depool/docker-
# compose.yml. Control never ups/downs on Umbrel (the lifecycle is
# umbrelOS's) — the file exists only so control's `docker compose ps/exec`
# status + wallet calls, run with COMPOSE_PROJECT_NAME=<app id>, resolve
# umbrelOS's own containers. Multi-arch: alpine:3.20 + apk packages are.
FROM alpine:3.20
RUN apk add --no-cache docker-cli docker-cli-compose nodejs
COPY stack/control/control.js /control.js
COPY stack/control/billing.js /billing.js
# the app's own page (control serves it at '/'; without it the app opens to a
# 404 and fails umbrelOS's browser-standard gate — see stack/control/page.js)
COPY stack/control/page.js /page.js
# control reads power/mode/role from COMPOSE_DIR/.env — umbrelOS never
# writes one, so the umbrel values are baked (node role, grind off)
COPY control.env /depool/.env
COPY docker-compose.yml /depool/docker-compose.yml
EXPOSE 28700
CMD ["node", "/control.js"]
