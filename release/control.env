# control.env — baked into the depool-control image as /depool/.env.
# control.js reads power/mode/role from COMPOSE_DIR/.env (readEnv) and the
# node UI + heartbeat carry what it reads. umbrelOS never materializes a
# stack .env, so the umbrel values live HERE — node role, the ASIC does the
# hashing. setPower() writing this file is a container-layer write with no
# effect on umbrel (by design: the app lifecycle belongs to umbrelOS).
DEPOOL_GRIND=0
DEPOOL_POWER=low
DEPOOL_MODE=smooth
DEPOOL_NETWORK=bip110-blake2b
